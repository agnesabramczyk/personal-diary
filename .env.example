# GCP Configuration
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=australia-southeast1
STORAGE_BUCKET=your-storage-bucket-name

# Authentication (for local development)
# For local development, use Application Default Credentials:
#   gcloud auth application-default login
# GOOGLE_APPLICATION_CREDENTIALS is not needed when using ADC
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json  # Optional: only if using service account key

# API Keys (comma-separated list for multiple users)
API_KEYS=your-api-key-here,another-api-key-here

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100

# Signed URL Expiration (in seconds)
SIGNED_URL_EXPIRATION=3600

# Environment
ENVIRONMENT=development

# Application Settings
LOG_LEVEL=INFO

# CORS Configuration
# Use "*" for development, specific origins for production (comma-separated)
# Use empty string "" to disable CORS entirely
CORS_ORIGINS=*